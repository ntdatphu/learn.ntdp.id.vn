---
import ChapterLayout from '../../src/layouts/ChapterLayout.astro';
import { fixtureCatalog, fixtureChapter } from './chapter';
---
<ChapterLayout chapter={fixtureChapter} catalog={fixtureCatalog}>
  <p slot="notice" class="fixture-notice">SYNTHETIC TEST FIXTURE — NOT PUBLISHED</p>
</ChapterLayout>
<style>.fixture-notice { max-width: 46rem; margin: 0 auto 2rem; padding: 0.75rem 1rem; border: 1px dashed #526f92; color: #40536d; font-size: 0.8125rem; }</style>
