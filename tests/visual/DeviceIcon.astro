---
import type { DeviceKind } from './topologies';
interface Props { kind: DeviceKind }
const { kind } = Astro.props;
---
<g class="ux-device-icon">
  {kind === 'switch' ? <>
    <rect class="ux-device-shell" x="-35" y="-20" width="70" height="40" rx="8"/>
    <path d="M-24-9H24"/>
    {[-24,-13,-2,9,20].map(x => <rect x={x} y="0" width="6" height="8" rx="1"/>)}
  </> : kind === 'router' ? <>
    <rect class="ux-device-shell" x="-32" y="-22" width="64" height="44" rx="14"/>
    <circle cx="0" cy="-1" r="7"/><path d="M-22-1H-7M7-1H22M0 6V15M-22-5V3M22-5V3"/>
  </> : kind === 'client' ? <>
    <rect class="ux-device-shell" x="-26" y="-19" width="52" height="34" rx="4"/>
    <path d="M-18 25H18M0 15V25M-18-11H18V7H-18Z"/>
  </> : kind === 'server' ? <>
    <rect class="ux-device-shell" x="-20" y="-25" width="40" height="50" rx="5"/>
    <path d="M-13-12H13M-13 0H13M-13 12H13"/><circle cx="-11" cy="-18" r="1"/>
  </> : <>
    <rect class="ux-device-shell" x="-25" y="-25" width="50" height="50" rx="14"/>
    <path d="M-15-3Q0-18 15-3M-9 3Q0-6 9 3"/><circle cx="0" cy="10" r="2"/>
  </>}
</g>
