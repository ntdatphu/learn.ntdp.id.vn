---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const { title = 'Learning Hub' } = Astro.props;
const favicon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#202936"/><path d="M8 9h5a5 5 0 0 1 3 1 5 5 0 0 1 3-1h5v14h-5a5 5 0 0 0-3 1 5 5 0 0 0-3-1H8V9Zm8 1v14" fill="none" stroke="white" stroke-width="1.5" stroke-linejoin="round"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`data:image/svg+xml,${encodeURIComponent(favicon)}`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader>
      <slot name="header" />
    </SiteHeader>
    <slot />
  </body>
</html>
