---
const { title = 'Learning Hub' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: 'Avenir Next', Avenir, 'Century Gothic', system-ui,
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    line-height: 1.5;
    color: #202936;
    background: #f6f7f9;
    color-scheme: light;
  }
</style>
