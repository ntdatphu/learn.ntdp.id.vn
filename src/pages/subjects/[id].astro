---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubjectArtwork from '../../components/SubjectArtwork.astro';
import { subjects } from '../../data/subjects.js';
import '../../styles/checklists.css';
import '../../styles/learning.css';
import { catalog } from '../../learning/catalog';
import { chapterHref } from '../../learning/resolve';

export function getStaticPaths() {
  return subjects.map((subject) => ({
    params: { id: subject.id },
    props: { subject },
  }));
}

const { subject } = Astro.props;
const chapters = catalog.chapters.filter(chapter => chapter.subjectId === subject.id && chapter.publication === 'published');
const parts = catalog.parts.filter(part => chapters.some(chapter => chapter.partId === part.id));
const homeUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title={`${subject.name} | Learning Hub`}>
  <main id="main-content" tabindex="-1">
    <div class="subject-intro page-width">
      <a class="back-link" href={homeUrl}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M19 12H5m6 6-6-6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to Subjects
      </a>
      <div class="subject-intro__content">
        <div><h1>{subject.name}</h1>
          {subject.id === 'ccna' && <a class="subject-resource-link" href={`${homeUrl}subjects/ccna/checklists/`}>Config checklists <span aria-hidden="true">→</span></a>}
        </div>
        <SubjectArtwork subjectId={subject.id} />
      </div>
    </div>
    <section class="chapters-section" aria-labelledby="chapters-heading">
      <div class="page-width">
        <h2 id="chapters-heading">Chapters</h2>
        {chapters.length ? <div class="subject-chapters">{parts.map(part => <section aria-labelledby={part.id}><h3 id={part.id}>{part.title}</h3><ul>{chapters.filter(chapter => chapter.partId === part.id).map(chapter => <li><a href={chapterHref(chapter, import.meta.env.BASE_URL)}>{chapter.title}<span aria-hidden="true">→</span></a></li>)}</ul></section>)}</div> : <div class="empty-state">
          <div class="empty-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M4 5h5a8 8 0 0 1 5 2 8 8 0 0 1 5-2h5v17h-5a8 8 0 0 0-5 2 8 8 0 0 0-5-2H4V5Zm10 2v17" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="empty-state__copy">
            <h3>Content coming soon.</h3>
            <p>Chapters and materials will appear here when they are ready.</p>
          </div>
        </div>}
      </div>
    </section>
  </main>
</BaseLayout>
