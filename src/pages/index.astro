---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubjectCard from '../components/SubjectCard.astro';
import { subjects } from '../data/subjects.js';
---

<BaseLayout title="Learning Hub">
  <div slot="header" class="subject-search" role="search">
    <label for="subject-search">Search subjects</label>
    <div class="search-field">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.75" />
        <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
      <input
        id="subject-search"
        type="search"
        aria-controls="subject-list"
        autocomplete="off"
        disabled
      />
    </div>
  </div>

  <main id="main-content" class="page-width" aria-labelledby="subjects-heading" tabindex="-1">
    <h1 id="subjects-heading">Subjects</h1>
    <ul id="subject-list" class="subject-list">
      {subjects.map((subject) => <SubjectCard subject={subject} />)}
    </ul>
    <p id="search-status" class="search-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </main>
</BaseLayout>

<script>
  const searchInput = document.querySelector('input#subject-search');
  const subjectList = document.getElementById('subject-list');
  const searchStatus = document.getElementById('search-status');

  if (
    searchInput instanceof HTMLInputElement &&
    subjectList instanceof HTMLUListElement &&
    searchStatus instanceof HTMLElement
  ) {
    const entries = Array.from(
      subjectList.querySelectorAll<HTMLElement>('li[data-subject-name]'),
    );
    const normalize = (value: string) =>
      value.trim().replace(/\s+/g, ' ').toLowerCase();

    function updateSubjects() {
      const query = normalize(searchInput.value);
      let matches = 0;

      for (const entry of entries) {
        const name = normalize(entry.dataset.subjectName ?? '');
        const visible = name.includes(query);
        entry.hidden = !visible;
        if (visible) matches += 1;
      }

      const message = matches === 0 ? 'No subjects found.' : '';
      if (searchStatus.textContent !== message) {
        searchStatus.textContent = message;
      }
    }

    searchInput.addEventListener('input', updateSubjects);
    searchInput.addEventListener('search', updateSubjects);
    updateSubjects();
    searchInput.disabled = false;
  }
</script>
