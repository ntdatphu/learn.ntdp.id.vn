---
const homeUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<header class="site-header">
  <div class="page-width header-content">
    <a class="site-identity" href={homeUrl}>
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="currentColor" />
        <path d="M8 9h5a5 5 0 0 1 3 1 5 5 0 0 1 3-1h5v14h-5a5 5 0 0 0-3 1 5 5 0 0 0-3-1H8V9Zm8 1v14" fill="none" stroke="white" stroke-width="1.5" stroke-linejoin="round" />
      </svg>
      <span>Learning Hub</span>
    </a>
    <slot />
  </div>
</header>
