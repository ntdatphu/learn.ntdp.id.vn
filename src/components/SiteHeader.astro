---
const homeUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<header class="site-header">
  <div class="page-width header-content">
    <a class="site-identity" href={homeUrl}>
      <img class="brand-mark" src={`${homeUrl}ntdp-mark.svg`} width="264" height="65" alt="" />
      <span>Learning Hub</span>
    </a>
  </div>
</header>
