---
import type { Prose } from '../../learning/model';
interface Props { content: Prose }
const { content } = Astro.props;
---
<div class="learning-prose">
  {content.paragraphs.map(paragraph => <p>{paragraph}</p>)}
  {content.items?.length ? <ul>{content.items.map(item => <li>{item}</li>)}</ul> : null}
</div>
